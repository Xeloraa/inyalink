{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "paths": {
      "@inyalink/shared": ["./packages/shared/src/index.ts"],
      "@inyalink/shared/*": ["./packages/shared/src/*"],
      "@inyalink/burmese": ["./packages/burmese/src/index.ts"],
      "@inyalink/burmese/*": ["./packages/burmese/src/*"]
    }
  }
}
