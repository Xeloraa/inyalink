# api
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=        # server only, never in web
AI_PROVIDER=gemini|openai|groq
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
MESSAGE_RETENTION_DAYS=90
AI_MAX_TURNS=5
DEMO_AUTO_APPROVE_PROS=false    # auto-approves professional applications, skipping admin review. Opt-in only.
DEMO_SEED_INTERESTS=false       # seeds fake interest + closes the matching window early. Opt-in only.
DEMO_SHARED_USER=false          # DANGER: unauth'd requests on session-required routes get a shared/caller-chosen
                                 # identity (incl. admin) via X-Demo-User-Id. Never gates AI chat — that always
                                 # works anonymously. Opt-in only for local/stage-demo use — default off.
DEMO_AI_FALLBACK=true          # serve demo AI fixtures when provider fails (default on; production OK)
ADMIN_EMAIL=                   # promote this Supabase Auth email to role=admin on /auth/me (case-insensitive)
AI_DAILY_CALL_CAP=2000         # circuit breaker: total /ai/* requests/day across every caller (default 2000)

# web  (VITE_ prefix = PUBLIC. Nothing secret. Baked in at build time.)
VITE_API_URL=                  # e.g. https://inyalink-api.up.railway.app — empty = relative /api (Vite proxy in dev)
VITE_SUPABASE_URL=           # same project URL as SUPABASE_URL
VITE_SUPABASE_ANON_KEY=      # anon/public key — auth session only
VITE_ACCESS_PASSWORD=        # soft pre-launch gate (public in bundle). Empty = no gate. Remove before launch.
# Google OAuth: in Supabase Auth → URL Configuration, add
#   {web origin}/auth/callback
# and enable the Google provider.

# api CORS (Railway) — comma-separated browser origins (quotes optional)
CORS_ORIGIN=                   # e.g. https://inyalink.com,https://inyalink-web.vercel.app
                               # empty = deny all except https://*.vercel.app previews (always allowed).
                               # Must be set explicitly in production — empty does NOT mean allow-all.
