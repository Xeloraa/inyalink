{
  "rewrites": [
    {
      "source": "/((?!assets/|images/|og\\.png|favicon\\.svg|apple-touch-icon\\.png).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/og.png",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=300, must-revalidate" },
        { "key": "Content-Type", "value": "image/png" }
      ]
    }
  ]
}
